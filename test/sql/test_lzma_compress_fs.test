# name: test/sql/test_lzma_compress_fs.test
# description: LZMA-Alone round-trip, compatibility, and invalid streams
# group: [sql]

require compression_fs

# Suffix detection and data integrity across multiple input/output buffers.
statement ok
COPY (SELECT i, md5(i::VARCHAR) AS s FROM range(10000) t(i)) TO '{TEMP_DIR}/data.csv.lzma' (HEADER);

query II
SELECT count(*), count(*) FILTER (WHERE s = md5(i::VARCHAR)) FROM read_csv('{TEMP_DIR}/data.csv.lzma');
----
10000	10000

# Explicit compression without a recognized suffix.
statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/explicit.csv' (HEADER, COMPRESSION 'lzma');

query I
SELECT * FROM read_csv('{TEMP_DIR}/explicit.csv', compression='lzma');
----
42

# No input still produces a complete LZMA-Alone stream.
statement ok
COPY (SELECT 1 AS i WHERE false) TO '{TEMP_DIR}/empty.lzma' (HEADER false);

query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/empty.lzma', header=false, columns={'i':'INTEGER'});
----
0

# Independent fixture: xz --format=lzma on b'i\n42\n'.
statement ok
COPY (SELECT from_hex('5d00008000ffffffffffffffff00348282817f91689bfffffdf1a000')) TO '{TEMP_DIR}/external.lzma' (FORMAT BLOB, COMPRESSION 'none');

query I
SELECT * FROM read_csv('{TEMP_DIR}/external.lzma');
----
42

# Invalid LZMA properties byte in the header.
statement ok
COPY (SELECT from_hex('ff00008000ffffffffffffffff00348282817f91689bfffffdf1a000')) TO '{TEMP_DIR}/invalid.lzma' (FORMAT BLOB, COMPRESSION 'none');

statement error
SELECT * FROM read_csv('{TEMP_DIR}/invalid.lzma', header=true, columns={'i':'INTEGER'});
----
Failed to decompress LZMA stream

# Missing end-of-stream bytes must not silently return partial data.
statement ok
COPY (SELECT from_hex('5d00008000ffffffffffffffff00348282817f91689bffff')) TO '{TEMP_DIR}/truncated.lzma' (FORMAT BLOB, COMPRESSION 'none');

statement error
SELECT * FROM read_csv('{TEMP_DIR}/truncated.lzma', header=true, columns={'i':'INTEGER'});
----
Truncated LZMA stream
