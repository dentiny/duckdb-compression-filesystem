# name: test/sql/test_deflate_compress_fs.test
# description: DEFLATE round-trip, zlib compatibility, and invalid streams
# group: [sql]

require compression_fs

# Suffix detection and data integrity across multiple input/output buffers.
statement ok
COPY (SELECT i, md5(i::VARCHAR) AS s FROM range(10000) t(i))
TO '{TEMP_DIR}/data.csv.deflate' (HEADER);

query II
SELECT count(*), count(*) FILTER (WHERE s = md5(i::VARCHAR)) FROM read_csv('{TEMP_DIR}/data.csv.deflate');
----
10000	10000

# Explicit compression without a recognized suffix.
statement ok
COPY (SELECT 42 AS i) TO '{TEMP_DIR}/explicit.csv' (HEADER, COMPRESSION 'deflate');

query I
SELECT * FROM read_csv('{TEMP_DIR}/explicit.csv', compression='deflate');
----
42

# No input still produces a complete zlib stream.
statement ok
COPY (SELECT 1 AS i WHERE false) TO '{TEMP_DIR}/empty.deflate' (HEADER false);

query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/empty.deflate', header=false, columns={'i':'INTEGER'});
----
0

# Independent fixture: Python zlib.compress(b'i\n42\n').
statement ok
COPY (SELECT from_hex('789ccbe43231e20200034400e4')) TO '{TEMP_DIR}/external.deflate' (FORMAT BLOB, COMPRESSION 'none');

query I
SELECT * FROM read_csv('{TEMP_DIR}/external.deflate');
----
42

# Corrupt Adler-32 checksum.
statement ok
COPY (SELECT from_hex('789ccbe43231e20200034400e5')) TO '{TEMP_DIR}/corrupt.deflate' (FORMAT BLOB, COMPRESSION 'none');

statement error
SELECT * FROM read_csv('{TEMP_DIR}/corrupt.deflate', header=true, columns={'i':'INTEGER'});
----
Failed to decompress deflate stream

# Missing trailer must not silently return partial data.
statement ok
COPY (SELECT from_hex('789ccbe43231e202000344')) TO '{TEMP_DIR}/truncated.deflate' (FORMAT BLOB, COMPRESSION 'none');

statement error
SELECT * FROM read_csv('{TEMP_DIR}/truncated.deflate', header=true, columns={'i':'INTEGER'});
----
Truncated deflate stream
